{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker in the dashboard: `class`, served at
  // https://class.2core.workers.dev. `wrangler deploy` fails if this names a
  // Worker that does not exist.
  "name": "class",
  // Pinned like clabridge's config so a deploy cannot land in the wrong account
  // when several are available on the machine.
  "account_id": "3e7aa377fa5d97b06247985e3b08ad21",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    // Prisma, pg, firebase-admin and the AWS SDK use Node built-ins.
    "nodejs_compat",
    // Keep outbound fetch from resolving to the Worker itself.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // No `services`/WORKER_SELF_REFERENCE binding on purpose. OpenNext uses it
  // only for its Durable Object queue (cache revalidation), which this app does
  // not configure, and a self-reference to a Worker that does not exist is a
  // hard deploy failure ("references Worker 'x' which was not found").
  "observability": {
      "enabled": true,
    },
    "vars": {
    // Tells src/lib/prisma.ts that it is running in workerd. Vercel does not
    // set this, so the Node path (a pooled global client) stays the default.
    "DEPLOYMENT_TARGET": "cloudflare",
  },
  "r2_buckets": [
    {
      "bucket_name": "lms-core-uploads",
      "binding": "lms_core_uploads"
    }
  ],
    // Hyperdrive in front of Neon. `opennextjs-cloudflare deploy` calls
  // `getPlatformProxy()`, which runs Wrangler's *local* Hyperdrive path even
  // when deploying for real: without a local connection string it aborts with
  // "When developing locally, you should use a local Postgres connection
  // string". The value is never used in production (the deployed Worker gets
  // the string from the Hyperdrive config), so it is a non-secret placeholder.
  //
  // For a real local database, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // in .dev.vars (gitignored); Wrangler prefers it over this value.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f7801154604f4b9895700cab6d991d49",
      "localConnectionString": "postgresql://hyperdrive-placeholder@127.0.0.1:5432/neondb"
    }
  ],
  // Optional: put a Hyperdrive in front of Neon and bind it here. Without it
  // the Worker connects to DATABASE_URL directly.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<hyperdrive-id>",
  //   },
  // ],
}
