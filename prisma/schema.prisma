// LMS Core — Prisma schema
//
// The models below reproduce the PRD (§5) specification verbatim. Fields marked
// `[+]` are additive extensions required by PRD modules that the base schema has
// no columns for — each one is annotated with the module that demands it.
//
// Prisma 7 removed `url` from the datasource block: connection strings for the
// CLI now live in `prisma.config.ts`, and the runtime gets its connection from
// the driver adapter passed to `new PrismaClient()` (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// For Node/Vercel (default) — binary engine, WASM query compiler
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// For Cloudflare Workers (workerd) — static WASM import via workerd runtime
// This avoids `new WebAssembly.Module(base64)` which is forbidden on workerd.
generator workerdClient {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workerd"
  runtime  = "workerd"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  TEACHER
  STUDENT
}

enum SubmissionState {
  ASSIGNED
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

/// [+] Module D — "Assignment Types: Assignments, Quizzes, Questions, Material"
enum AssignmentType {
  ASSIGNMENT
  QUIZ
  QUESTION
  MATERIAL
}

/// [+] Module C — who is allowed to post and comment on the stream.
enum PostPolicy {
  STUDENTS_CAN_POST_AND_COMMENT
  STUDENTS_CAN_COMMENT_ONLY
  ONLY_TEACHERS
}

/// [+] CLA Bridge: the school level a student picks once.
enum BridgeLevel {
  S4
  S5
  S6
}

/// [+] Notification feed, so a user who was offline still sees what happened.
enum NotificationType {
  ANNOUNCEMENT_POSTED
  COMMENT_ADDED
  ASSIGNMENT_CREATED
  WORK_SUBMITTED
  GRADE_RETURNED
  ENROLLED
  /// [+] A student asked for an authorized absence.
  ABSENCE_REQUESTED
  /// [+] A teacher answered that request.
  ABSENCE_DECIDED
}

// --- SDMS: platform, school tenancy, cohorts and imports --------------------

enum PlatformRole {
  USER
  SUPERUSER
}

enum SchoolRole {
  ADMIN
  TEACHER
}

enum SchoolMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  MOVED
  LEFT
}

enum CourseKind {
  HOMEROOM
  SUBJECT
}

enum JoinCodeKind {
  SCHOOL
  COHORT
  COURSE
}

enum PasswordPolicy {
  DEFAULT
  CUSTOM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String   @id // Firebase UID
  email       String   @unique
  displayName String?
  avatarUrl   String?
  role        Role     @default(STUDENT)
  /// Administrator rights are an overlay, not a third role: they unlock the
  /// admin console without changing how the person is treated in classes.
  isAdmin     Boolean  @default(false)

  // [+] SDMS — imported identity and platform tenancy. The primary id remains
  // the original Firebase UID; alternate Firebase accounts resolve through
  // AuthIdentity instead of rewriting any foreign key.
  studentCode         String?      @unique
  nameAsImported      String?
  gender              Gender?
  platformRole        PlatformRole @default(USER)
  contactEmail        String?
  authKind            String       @default("GOOGLE")
  passwordOverridden  Boolean      @default(false)
  lastSignInAt        DateTime?
  archivedAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments     Enrollment[]
  createdCourses  Course[]         @relation("TeacherCourses")
  submissions     Submission[]
  comments        Comment[]
  announcements   Announcement[]
  attachments     Attachment[]     @relation("UploadedAttachments") // [+] Module D
  notifications   Notification[]
  bridgeProfile   BridgeProfile?
  bridgeEstimates BridgeEstimate[]
  claimedBridgeLegacy BridgeLegacyStudent? @relation("ClaimedBridgeLegacy")

  // [+] School records
  attendanceRecords  AttendanceRecord[]
  markedSessions     AttendanceSession[]  @relation("MarkedAttendanceSessions")
  attendanceRequests AttendanceRequest[]  @relation("StudentAttendanceRequests")
  decidedRequests    AttendanceRequest[]  @relation("DecidedAttendanceRequests")
  gradeScores        GradeScore[]
  authoredReports    ReportComment[]      @relation("AuthoredReportComments")
  studentReports     ReportComment[]      @relation("StudentReportComments")

  // [+] SDMS
  schoolMemberships SchoolMember[]
  cohortMemberships CohortMember[]
  identities        AuthIdentity[]

  @@index([role])
  @@index([isAdmin])
  @@index([platformRole])
  @@index([archivedAt])
}

/// [+] A school is the tenant boundary. Course-owned records inherit tenancy
/// through Course.schoolId; users may belong to more than one school.
model School {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  createdById String?
  disabledAt  DateTime?
  isLegacy    Boolean   @default(false)
  /// Existing schools require approval; the flag makes the policy explicit and
  /// leaves room for a future open-join school without changing this schema.
  requiresApproval Boolean @default(true)
  createdAt   DateTime  @default(now())

  members          SchoolMember[]
  combinations     Combination[]
  cohorts          Cohort[]
  courses          Course[]
  terms            Term[]
  joinCodes        JoinCode[]
  invites          SchoolInvite[]
  imports          CohortImport[]
  importPreviews   ImportPreview[]
  assignmentGroups AssignmentGroup[]
  auditEvents      AuditEvent[]

  @@index([isLegacy])
  @@index([disabledAt])
}

model SchoolMember {
  id          String             @id @default(cuid())
  schoolId    String
  userId      String
  role        SchoolRole         @default(TEACHER)
  status      SchoolMemberStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedById String?
  decidedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId, status])
  @@index([schoolId, role, status])
}

model SchoolInvite {
  id           String     @id @default(cuid())
  schoolId     String
  email        String?
  role         SchoolRole @default(TEACHER)
  tokenHash    String     @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdById  String
  createdAt    DateTime   @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, email])
}

model JoinCode {
  id        String       @id @default(cuid())
  code      String       @unique
  kind      JoinCodeKind
  schoolId  String?
  cohortId  String?
  courseId  String?
  createdAt DateTime     @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@index([schoolId])
  @@index([cohortId])
  @@index([courseId])
}

model Combination {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  shortName String
  stream    String?
  /// Retained for display/debugging. Import resolution uses CombinationAlias,
  /// whose normalized value is unique inside a school.
  aliases   String[] @default([])
  createdAt DateTime @default(now())

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohorts     Cohort[]
  aliasRows   CombinationAlias[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model CombinationAlias {
  id             String @id @default(cuid())
  schoolId       String
  combinationId  String
  alias          String
  normalizedAlias String

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, normalizedAlias])
  @@index([combinationId])
}

model Cohort {
  id               String         @id @default(cuid())
  schoolId         String
  combinationId    String
  label            String
  grade            String
  rawGrade         String?
  academicYear     Int
  passwordSeedYear Int
  passwordPolicy   PasswordPolicy @default(DEFAULT)
  passwordSetAt    DateTime?
  ownerId          String?
  createdById      String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  combination Combination   @relation(fields: [combinationId], references: [id], onDelete: Restrict)
  members     CohortMember[]
  courses     Course[]
  imports     CohortImport[]
  joinCodes   JoinCode[]

  @@unique([schoolId, label, academicYear])
  @@index([schoolId, academicYear])
  @@index([combinationId])
}

model CohortMember {
  id                 String       @id @default(cuid())
  cohortId           String
  userId             String
  status             MemberStatus @default(ACTIVE)
  claimedAt          DateTime?
  claimedIpHash      String?
  lastSignInAt       DateTime?
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())

  cohort   Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputes ClaimDispute[]

  @@unique([cohortId, userId])
  @@index([userId, status])
  @@index([cohortId, status])
}

/// The parsed workbook lives server-side for thirty minutes. Only the opaque
/// preview token goes to the browser; passwords and rows never go into a JWT.
model ImportPreview {
  id          String    @id @default(cuid())
  schoolId    String
  createdById String
  tokenHash   String    @unique
  commitKey   String    @unique
  fileName    String
  fileHash    String
  payload     Json
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdById, expiresAt])
}

model CohortImport {
  id             String         @id @default(cuid())
  cohortId       String
  schoolId       String
  fileName       String
  fileHash       String
  importedById   String?
  rows           Int
  created        Int
  updated        Int
  skipped        Int
  warnings       Json
  passwordPolicy PasswordPolicy
  createdAt      DateTime       @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, createdAt])
}

/// One row per Firebase project + UID. Both password and Google Firebase
/// accounts use provider "firebase"; the sign-in method is not an identity key.
model AuthIdentity {
  id          String   @id @default(cuid())
  userId      String
  provider    String   @default("firebase")
  projectId   String
  providerUid String
  email       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, projectId, providerUid])
  @@index([userId])
}

model ClaimDispute {
  id           String    @id @default(cuid())
  memberId     String
  code         String
  note         String?
  ipHash       String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  member CohortMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, resolvedAt])
  @@index([code])
}

model AssignmentGroup {
  id          String   @id @default(cuid())
  schoolId    String
  createdById String
  title       String
  subject     String?
  createdAt   DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([schoolId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  codeHash  String
  ipHash    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([codeHash, createdAt])
  @@index([ipHash, createdAt])
}

/// Append-only audit metadata. Student names, codes, passwords and workbook
/// contents are deliberately excluded from this record.
model AuditEvent {
  id         String   @id @default(cuid())
  schoolId   String?
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}

/// [+] CLA Bridge: the student's chosen school level. Students are locked to
/// one level, mirroring the standalone app; admins may inspect every level.
model BridgeProfile {
  userId    String      @id
  level     BridgeLevel
  username  String?     @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// [+] CLA Bridge: one saved estimator document per student and level.
/// The JSON columns keep the exact shape of the original Firestore documents
/// so imported estimates retain their marks, assessment tables and goals.
model BridgeEstimate {
  id               String      @id @default(cuid())
  userId           String
  level            BridgeLevel
  combinationCode  String      @default("")
  marks            Json        @default("{}")
  targets          Json        @default("{}")
  goalTargets      Json        @default("{}")
  overallTarget    String?
  usefulnessRating Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
  @@index([level])
}

/// [+] CLA Bridge: a Firestore student waiting for an LMS Core account.
///
/// The standalone app ran on a different Firebase project, so its UIDs cannot
/// sign in here and its rows cannot point at a `User` until the student
/// registers with the same email. Staging keeps the nickname reserved and the
/// estimates intact until then; `claimLegacyBridgeData` moves the row into
/// `BridgeProfile` / `BridgeEstimate` on the first visit to `/bridge`.
model BridgeLegacyStudent {
  id              String      @id @default(cuid())
  /// Firestore document id (`students/{uid}`), used for idempotent re-imports.
  sourceUid       String      @unique
  /// Lowercased. Null only for the one source document that had no address
  /// anywhere, not even in Firebase Auth.
  email           String?     @unique
  /// The name the student had in the standalone app, when the source knew one.
  displayName     String?
  level           BridgeLevel?
  username        String?
  /// `{ "S4": { combinationCode, marks, targets, goalTargets, ... }, ... }`
  estimates       Json        @default("{}")
  claimedByUserId String?     @unique
  claimedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  claimedBy User? @relation("ClaimedBridgeLegacy", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([claimedAt])
}

/// [+] In-app notification feed (the bell menu). Persisted rather than
/// realtime-only so a user who was offline still sees what they missed.
model Notification {
  id       String           @id @default(cuid())
  userId   String
  courseId String?
  type     NotificationType
  title    String
  body     String?
  linkPath String?
  readAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Courses & roster
// ---------------------------------------------------------------------------

model Course {
  id        String   @id @default(cuid())
  name      String
  section   String?
  subject   String?
  room      String?
  code      String   @unique
  teacherId String
  teacher   User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// [+] Muted slate accent token (e.g. "slate"), NOT a saturated brand colour.
  accent      String     @default("slate")
  /// [+] Module B — class description shown on the stream header.
  description String?
  /// [+] Module C — stream moderation setting.
  postPolicy  PostPolicy @default(STUDENTS_CAN_POST_AND_COMMENT)

  // [+] SDMS — nullable during the additive migration. Existing rows are
  // backfilled to the Legacy school before tenant constraints are enforced.
  schoolId String?
  cohortId String?
  kind     CourseKind @default(SUBJECT)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  joinCodes     JoinCode[]
  enrollments   Enrollment[]
  announcements Announcement[]
  assignments   Assignment[]
  topics        Topic[]
  notifications Notification[]

  // [+] School records
  schedules          CourseSchedule[]
  attendanceSessions AttendanceSession[]
  attendanceRequests AttendanceRequest[]
  gradeCategories    GradeCategory[]
  gradeItems         GradeItem[]
  reportComments     ReportComment[]

  @@index([teacherId])
  @@index([archived])
  @@index([schoolId])
  @@index([cohortId])
  @@unique([cohortId, subject, kind])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  role      Role     @default(STUDENT)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// [+] Module C — "Moderation controls allowing teachers to ... mute students"
  muted Boolean @default(false)
  /// [+] SDMS — LEFT/MOVED students lose current access without deleting the
  /// enrollment row that anchors historical marks and submissions.
  active  Boolean   @default(true)
  leftAt  DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([courseId, active])
  @@index([userId])
}

model Topic {
  id       String @id @default(cuid())
  name     String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// [+] Module D — teachers order topics on the Classwork page
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  assignments Assignment[]

  @@index([courseId, sortOrder])
}

// ---------------------------------------------------------------------------
// Stream
// ---------------------------------------------------------------------------

model Announcement {
  id        String    @id @default(cuid())
  content   String
  courseId  String
  authorId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime  @default(now())

  /// [+] Module C — teachers pin announcements to the top of the stream
  pinned      Boolean      @default(false)
  updatedAt   DateTime     @updatedAt
  attachments Attachment[] // [+] Module C — "rich text and file attachments"

  @@index([courseId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Classwork
// ---------------------------------------------------------------------------

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  maxPoints   Int          @default(100)
  courseId    String
  topicId     String?
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  submissions Submission[]
  createdAt   DateTime     @default(now())

  /// [+] Module D — Assignments / Quizzes / Questions / Material
  type      AssignmentType @default(ASSIGNMENT)
  /// [+] §3 — teachers draft classwork before releasing it to students
  published Boolean        @default(true)
  /// [+] Teachers can close an assignment to new turn-ins.
  acceptingSubmissions Boolean @default(true)
  /// [+] Whether work turned in after the due date is still accepted.
  allowLateSubmissions  Boolean @default(true)
  updatedAt DateTime       @updatedAt

  // [+] SDMS — copies created together remain independently gradable.
  groupId   String?
  group     AssignmentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Per-class fields deliberately changed after a group-wide edit.
  overrides Json?

  attachments Attachment[]
  rubric      RubricCriterion[] // [+] Module D — "rubric breakdown"
  comments    Comment[]
  gradeItem   GradeItem?

  @@index([courseId, createdAt])
  @@index([topicId])
  @@index([groupId])
  @@unique([groupId, courseId])
}

/// [+] Module D — "grade input, rubric breakdown, and private comments"
model RubricCriterion {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  points       Int        @default(10)
  sortOrder    Int        @default(0)

  scores RubricScore[]

  @@index([assignmentId, sortOrder])
}

/// [+] Per-criterion marks awarded on a single submission.
model RubricScore {
  id           String          @id @default(cuid())
  submissionId String
  criterionId  String
  points       Float
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([criterionId])
}

// ---------------------------------------------------------------------------
// Submissions
// ---------------------------------------------------------------------------

model Submission {
  id           String          @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionState @default(ASSIGNED)
  grade        Float?
  feedback     String?
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime?
  createdAt    DateTime        @default(now())

  /// [+] Free-text student response (short-answer / Question type)
  content    String?
  /// [+] Set when a teacher records a grade; drives "Graded on ..." in the UI
  gradedAt   DateTime?
  /// [+] Set when work is returned to the student
  returnedAt DateTime?
  updatedAt  DateTime  @updatedAt

  attachments  Attachment[] // [+] Module D — multi-file submissions
  rubricScores RubricScore[]
  comments     Comment[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
}

// ---------------------------------------------------------------------------
// Comments
// ---------------------------------------------------------------------------

model Comment {
  id             String        @id @default(cuid())
  content        String
  authorId       String
  announcementId String?
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  /// [+] Module D — class comments on classwork
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// [+] Module D — "attach private feedback" on a specific submission
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// [+] Private comments are visible only to the submission's student and course teachers
  isPrivate    Boolean     @default(false)

  @@index([announcementId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([submissionId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------

/// [+] Module D — "Uploads file directly to Cloudflare R2 / S3 -> Saves metadata
/// reference to database". One row per uploaded object.
model Attachment {
  id       String  @id @default(cuid())
  name     String
  url      String
  /// Object key in the bucket, retained so the file can be deleted or re-signed.
  key      String
  mimeType String?
  size     Int?

  uploadedById String
  uploadedBy   User   @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId   String?
  submission     Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([announcementId])
  @@index([assignmentId])
  @@index([submissionId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// + School records — terms, gradebook, attendance, schedule
//
// These are first-class LMS Core models. They have no relationship to any
// external school system: a teacher enters marks and attendance here, and a
// student reads what is stored here.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  LEFT_EARLY
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// [+] A reporting period. Exactly one term should be active per school.
/// schoolId is nullable only for the additive legacy migration window.
model Term {
  id           String   @id @default(cuid())
  academicYear String // "2026-2027"
  name         String // "Term 1"
  startsOn     DateTime
  endsOn       DateTime
  isActive     Boolean  @default(false)
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  gradeCategories GradeCategory[]
  gradeItems      GradeItem[]
  reportComments  ReportComment[]

  @@unique([academicYear, name])
  @@index([schoolId, isActive])
}

/// [+] A recurring weekly slot. Courses meet on a pattern, not on dates.
model CourseSchedule {
  id       String  @id @default(cuid())
  courseId String
  /// 0 = Monday … 6 = Sunday
  weekday  Int
  /// School-local wall clock, "HH:mm".
  startsAt String
  endsAt   String
  room     String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, weekday])
}

/// [+] One register: a course on a date (and period, when it meets twice).
model AttendanceSession {
  id         String   @id @default(cuid())
  courseId   String
  /// Date-only value stored at UTC midnight; never carries a time of day.
  date       DateTime
  /// Set only when the course meets more than once on the same date.
  period     String?
  topic      String?
  markedById String
  markedAt   DateTime @default(now())

  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  markedBy User               @relation("MarkedAttendanceSessions", fields: [markedById], references: [id])
  records  AttendanceRecord[]

  @@unique([courseId, date, period])
  @@index([courseId, date])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  sessionId   String
  studentId   String
  status      AttendanceStatus
  note        String?
  minutesLate Int?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([status])
}

/// [+] A student's request for an authorized absence. Approving it never writes
/// attendance records — the teacher's register stays the source of truth.
model AttendanceRequest {
  id           String        @id @default(cuid())
  courseId     String
  studentId    String
  fromDate     DateTime
  toDate       DateTime
  reason       String
  status       RequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User   @relation("StudentAttendanceRequests", fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("DecidedAttendanceRequests", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([studentId])
}

/// [+] A weighted bucket of grade items, e.g. "Coursework" 40, "Tests" 60.
/// Weights are validated in the application layer to sum to 100 per course + term.
model GradeCategory {
  id       String @id @default(cuid())
  courseId String
  termId   String
  name     String
  weight   Int

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term   Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  items  GradeItem[]

  @@unique([courseId, termId, name])
  @@index([courseId, termId])
}

/// [+] One graded column. `assignmentId` links it to classwork so a graded
/// submission feeds the same average instead of creating a second gradebook.
model GradeItem {
  id           String   @id @default(cuid())
  courseId     String
  termId       String
  categoryId   String
  title        String
  maximum      Decimal  @db.Decimal(6, 2)
  assessedOn   DateTime
  assignmentId String?  @unique

  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term       Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  category   GradeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  scores     GradeScore[]

  @@unique([courseId, termId, title, assessedOn])
  @@index([courseId, termId])
  @@index([categoryId])
}

/// [+] A score is nullable on purpose: "not marked" is not zero.
model GradeScore {
  id          String   @id @default(cuid())
  gradeItemId String
  studentId   String
  score       Decimal? @db.Decimal(6, 2)

  gradeItem GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([gradeItemId, studentId])
  @@index([studentId])
}

/// [+] The teacher's written comment on a student's term report.
model ReportComment {
  id        String   @id @default(cuid())
  courseId  String
  termId    String
  studentId String
  authorId  String
  body      String
  updatedAt DateTime @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term    Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  student User   @relation("StudentReportComments", fields: [studentId], references: [id], onDelete: Cascade)
  author  User   @relation("AuthoredReportComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([courseId, termId, studentId])
  @@index([studentId])
}
