# Read by `wrangler dev` / `opennextjs-cloudflare preview`.
#
# Only non-secret local settings belong in this file. Put real values in
# `.dev.vars.local` (gitignored) or export them in the shell.
NEXTJS_ENV=development
DEPLOYMENT_TARGET=cloudflare
# Local Hyperdrive connection string for preview (password is placeholder for local-only dev)
# Replace with real Neon connection string if running against a local database
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:5432/postgres
